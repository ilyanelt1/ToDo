# Copy this file to .env and replace the example password.
# Never commit the real .env file to Git.

POSTGRES_DB=todo
POSTGRES_USER=todo_app
# Use a long random hexadecimal password to avoid URL-encoding issues.
POSTGRES_PASSWORD=replace_with_a_long_random_hex_password
ALLOWED_ORIGINS=http://localhost:8081
FRONTEND_PORT=8081
